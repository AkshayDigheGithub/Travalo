# ---------------------------------------------------------------------------
# bookmyflight.lol environment
#
# Copy to .env.local for development. Only NEXT_PUBLIC_* values reach the
# browser — everything else stays on the server.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical URLs, Open Graph tags, robots.txt and the
# sitemap. Set this to your real domain in production (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default display currency shown before a visitor picks one.
# One of: INR USD EUR GBP AED SGD AUD CAD JPY
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# ---------------------------------------------------------------------------
# Travelpayouts (server-only — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# API token from your Travelpayouts account (Dashboard → API tokens).
TRAVELPAYOUTS_API_TOKEN=

# Affiliate marker from your Travelpayouts account. Clicks are attributed with
# `marker=<marker>.<sub_id>`, where the sub-id encodes the search intent.
TRAVELPAYOUTS_MARKER=

# Optional: the host reported to Travelpayouts when generating links.
TRAVELPAYOUTS_HOST=

# Optional: market/locale code passed to the flight price endpoint (e.g. "in").
TRAVELPAYOUTS_MARKET=

# Development provider. `true` serves realistic sample data so the whole
# product runs before credentials exist; production sets this to `false`.
# When unset, it defaults to true if TRAVELPAYOUTS_API_TOKEN is empty.
TRAVELPAYOUTS_MOCK=true

# Exercise UI states against the mock provider:
#   normal | empty | error | slow
TRAVELPAYOUTS_MOCK_SCENARIO=normal

# How long a provider request may take before we give up, in milliseconds.
PROVIDER_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Outbound link signing
# ---------------------------------------------------------------------------

# Secret used to sign affiliate redirect URLs so /go can never be turned into an
# open redirect. Any random string of 32+ characters, e.g.
#   openssl rand -hex 32
# If unset, it is derived from TRAVELPAYOUTS_API_TOKEN; set it explicitly in
# production so links stay valid across instances and token rotations.
AFFILIATE_LINK_SECRET=

# ---------------------------------------------------------------------------
# Database (optional — search works without it)
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Supabase: Project settings → Database →
# Connection string → URI (use the pooled connection for serverless).
# Used for destination content, search analytics and affiliate click tracking.
DATABASE_URL=

# Maximum pooled connections per serverless instance.
DATABASE_POOL_MAX=3

# Set to false to disable all analytics writes.
ANALYTICS_ENABLED=true

# ---------------------------------------------------------------------------
# Cache (optional — an in-memory cache is used when absent)
# ---------------------------------------------------------------------------

# Upstash Redis REST credentials. Used for response caching and rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Currency conversion (optional)
# ---------------------------------------------------------------------------

# Endpoint returning { "rates": { "USD": 0.012, ... } }. `{base}`, `{symbols}`
# and `{apiKey}` are substituted. Without it, prices are only ever shown in the
# currency the provider quoted — we never invent a conversion rate.
# Example: https://api.exchangerate.host/latest?base={base}&symbols={symbols}
EXCHANGE_RATES_API_URL=
EXCHANGE_RATES_API_KEY=
